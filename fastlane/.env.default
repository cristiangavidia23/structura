# Plantilla de variables de entorno para los lanes de Fastlane.
#
# Este archivo SÍ se commitea — no tiene secretos, solo documenta qué
# variables existen y para qué sirve cada una. Para usarlas de verdad:
#
#   cp fastlane/.env.default fastlane/.env
#   # completar los valores reales en fastlane/.env
#
# `fastlane/.env` está en .gitignore — nunca se commitea. Fastlane lo carga
# solo si existe.

# --- Identidad de la app y de la cuenta (Appfile) ---

# Ya tiene un valor por defecto correcto en fastlane/Appfile
# (com.cristiangavidia.structura); solo hace falta si alguna vez cambia.
STRUCTURA_APP_IDENTIFIER=

# El correo de la cuenta de Apple Developer / App Store Connect.
STRUCTURA_APPLE_ID=

# App Store Connect → Users and Access → esquina superior derecha del
# panel de equipos. Solo hace falta si la cuenta pertenece a más de un
# equipo.
STRUCTURA_ITC_TEAM_ID=

# --- App Store Connect API key (para latest_testflight_build_number y upload_to_testflight) ---
#
# Se genera en App Store Connect → Users and Access → Integrations →
# App Store Connect API → el botón "+" (rol "App Manager" alcanza).
# Descarga un único archivo .p8 — guardarlo fuera del repo, por ejemplo en
# ~/.appstoreconnect/private_keys/, y apuntar STRUCTURA_ASC_KEY_FILEPATH ahí.
STRUCTURA_ASC_KEY_ID=
STRUCTURA_ASC_ISSUER_ID=
STRUCTURA_ASC_KEY_FILEPATH=
